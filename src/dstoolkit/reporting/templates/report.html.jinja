<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 0; padding: 0 24px 48px; color: #1c1c1c; background: #fafafa; }
  h1 { margin-top: 32px; }
  h2 { margin-top: 40px; border-bottom: 2px solid #e0e0e0; padding-bottom: 6px; }
  .meta { color: #666; }
  .cards { display: flex; flex-wrap: wrap; gap: 16px; margin: 16px 0; }
  .card { background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px 20px; min-width: 140px; }
  .card .value { font-size: 1.6em; font-weight: 600; }
  .card .label { color: #666; font-size: 0.85em; }
  table { border-collapse: collapse; width: 100%; margin: 12px 0; background: #fff; }
  th, td { border: 1px solid #e0e0e0; padding: 6px 10px; text-align: left; font-size: 0.9em; }
  th { background: #f0f0f0; }
  ul.log { background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px 32px; }
  .pass { color: #1e8e3e; font-weight: 600; }
  .fail { color: #c0392b; font-weight: 600; }
  .badge-pass { background: #e6f4ea; color: #1e8e3e; padding: 2px 8px; border-radius: 10px; font-size: 0.8em; }
  .badge-fail { background: #fce8e6; color: #c0392b; padding: 2px 8px; border-radius: 10px; font-size: 0.8em; }
  .charts { display: flex; flex-wrap: wrap; gap: 16px; }
  .charts figure { margin: 0; }
  .charts img { max-width: 100%; border: 1px solid #e0e0e0; border-radius: 8px; background: #fff; }
  .charts figcaption { margin-top: 6px; font-size: 0.85em; color: #666; text-align: center; }
  .chart-error { border: 1px dashed #e0e0e0; border-radius: 8px; padding: 16px; color: #888; font-style: italic; font-size: 0.85em; max-width: 260px; }
  .empty { color: #888; font-style: italic; }
</style>
</head>
<body>

<h1>{{ title }}</h1>
<p class="meta">Generated by dstoolkit</p>

<h2>Overview</h2>
<div class="cards">
  <div class="card"><div class="value">{{ profile.row_count }}</div><div class="label">Rows</div></div>
  <div class="card"><div class="value">{{ profile.col_count }}</div><div class="label">Columns</div></div>
  <div class="card"><div class="value">{{ profile.duplicate_rows }}</div><div class="label">Duplicate rows</div></div>
  <div class="card"><div class="value">{{ "%.1f"|format(profile.memory_usage_kb) }} KB</div><div class="label">Memory usage</div></div>
</div>

<h2>Cleaning Log</h2>
{% if cleaning_actions %}
<ul class="log">
  {% for action in cleaning_actions %}
  <li>{{ action }}</li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">No cleaning actions were needed.</p>
{% endif %}

<h2>Validation Results</h2>
<p>
  {% if validation.passed %}
    <span class="badge-pass">ALL RULES PASSED</span>
  {% else %}
    <span class="badge-fail">{{ validation.issues|length }} ISSUE(S) FOUND</span>
  {% endif %}
  &nbsp;({{ validation.rules_passed }}/{{ validation.rules_evaluated }} rules passed)
</p>
{% if validation.issues %}
<table>
  <tr><th>Rule</th><th>Column</th><th>Message</th><th>Affected rows</th></tr>
  {% for issue in validation.issues %}
  <tr>
    <td class="fail">{{ issue.rule }}</td>
    <td>{{ issue.column }}</td>
    <td>{{ issue.message }}</td>
    <td>{{ issue.affected_rows }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<h2>Column Profiles</h2>
<table>
  <tr>
    <th>Column</th><th>Type</th><th>Non-null</th><th>Null</th><th>Null rate</th><th>Unique</th><th>Summary</th>
  </tr>
  {% for col in profile.columns %}
  <tr>
    <td>{{ col.name }}</td>
    <td>{{ col.dtype }}</td>
    <td>{{ col.non_null }}</td>
    <td>{{ col.null }}</td>
    <td>{{ "%.1f%%"|format(col.null_rate * 100) }}</td>
    <td>{{ col.unique }}</td>
    <td>
      {% if col.stats %}
        min={{ "%.3g"|format(col.stats.min) }}, max={{ "%.3g"|format(col.stats.max) }},
        mean={{ "%.3g"|format(col.stats.mean) }}, median={{ "%.3g"|format(col.stats.median) }}
      {% elif col.top_values %}
        {% for value, count in col.top_values %}{{ value }} ({{ count }}){% if not loop.last %}, {% endif %}{% endfor %}
      {% endif %}
    </td>
  </tr>
  {% endfor %}
</table>

<h2>Charts</h2>
<div class="charts">
  {% for chart in charts %}
    {% if chart.data_uri %}
    <figure>
      <img src="{{ chart.data_uri }}" alt="{{ chart.title }}">
      <figcaption>{{ chart.title }}</figcaption>
    </figure>
    {% else %}
    <div class="chart-error">{{ chart.title }}: {{ chart.error }}</div>
    {% endif %}
  {% endfor %}
  {% if not charts %}
  <p class="empty">No charts to display.</p>
  {% endif %}
</div>

</body>
</html>
